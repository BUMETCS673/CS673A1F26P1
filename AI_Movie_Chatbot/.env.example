# Optional overrides for an existing database. Replace the placeholders before use.
# No .env is needed for the default Docker setup and its fictional sample users.
DB_HOST=database
DB_PORT=5432
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=2000
